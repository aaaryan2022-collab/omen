# OMEN environment template — never commit real secrets here.
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=
TEMPERATURE=0.2
MAX_CONTEXT=4096
TIMEOUT=60
VOICE_ENABLED=true
DAILY_BRIEFING_ENABLED=false
ALLOWED_DIRECTORIES=[]
# Secrets (optional, prefer Windows Credential Manager)
# OLLAMA_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
OMEN_OFFLINE_FIRST=true
OMEN_LOCAL_ONLY=1
OMEN_NO_TELEMETRY=1
OMEN_PERMISSION_STRICT=1
