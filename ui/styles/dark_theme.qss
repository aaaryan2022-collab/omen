/* ==========================================================
   OMEN — Holographic Sci-Fi Cybernetic Stylesheet
   ========================================================== */

* {
    font-family: "Segoe UI", "Consolas", sans-serif;
    outline: none;
}

QMainWindow, QWidget#centralWidget {
    background-color: #070B12;
    color: #F1F5F9;
}

/* Top Navigation Bar */
QFrame#topbar {
    background-color: #0A0F19;
    border-bottom: 1px solid #1A263D;
    padding: 6px 16px;
}

QLabel#topbarBrand {
    color: #00F0FF;
    font-size: 16pt;
    font-weight: 900;
    letter-spacing: 3px;
}

QLabel#topbarMode {
    color: #64748B;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#topbarStatus {
    color: #00FF9D;
    font-size: 9pt;
    font-weight: bold;
    background-color: rgba(0, 255, 157, 0.1);
    border: 1px solid rgba(0, 255, 157, 0.3);
    border-radius: 6px;
    padding: 4px 10px;
}

/* Sidebar */
QWidget#sidebar {
    background-color: #090E17;
    border-right: 1px solid #162238;
}

QLabel#brandLabel {
    color: #00F0FF;
    font-size: 20pt;
    font-weight: 900;
    letter-spacing: 4px;
}

QLabel#brandSubtitle {
    color: #94A3B8;
    font-size: 8pt;
    letter-spacing: 1.5px;
}

QListWidget#navList {
    background-color: transparent;
    border: none;
    padding: 6px;
}

QListWidget#navList::item {
    padding: 10px 14px;
    border-radius: 8px;
    margin: 3px 0px;
    color: #94A3B8;
    font-size: 10.5pt;
    font-weight: 600;
    border: 1px solid transparent;
}

QListWidget#navList::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(0, 240, 255, 0.18), stop:1 rgba(0, 240, 255, 0.04));
    color: #00F0FF;
    border: 1px solid rgba(0, 240, 255, 0.35);
    border-left: 3px solid #00F0FF;
}

QListWidget#navList::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.04);
    color: #F1F5F9;
    border: 1px solid #1E2C48;
}

/* Futuristic HUD Dashboard */
QLabel#hudBrand {
    color: #00F0FF;
    font-size: 26pt;
    font-weight: 900;
    letter-spacing: 4px;
}

QLabel#hudSubtitle {
    color: #64748B;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 3px;
}

QLabel#hudTime {
    color: #F1F5F9;
    font-size: 22pt;
    font-weight: 800;
    letter-spacing: 2px;
}

QLabel#hudDate {
    color: #00F0FF;
    font-size: 9pt;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#hudStatus {
    color: #94A3B8;
    font-size: 9.5pt;
    font-weight: 700;
    letter-spacing: 2px;
}

/* Cards & Glass Panels */
QFrame#hudCard, QFrame.hudCard {
    background-color: rgba(18, 26, 43, 0.7);
    border: 1px solid #1E2C48;
    border-radius: 12px;
    padding: 14px;
}

QFrame#hudCard:hover, QFrame.hudCard:hover {
    border: 1px solid rgba(0, 240, 255, 0.35);
    background-color: rgba(24, 35, 58, 0.8);
}

/* Buttons */
QPushButton {
    background-color: #121A2B;
    color: #F1F5F9;
    border: 1px solid #223252;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1B273F;
    border: 1px solid #00F0FF;
    color: #00F0FF;
}

QPushButton:pressed {
    background-color: rgba(0, 240, 255, 0.2);
}

QPushButton#primaryBtn, QPushButton.primaryBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00C4D4, stop:1 #00F0FF);
    color: #070B12;
    border: none;
    font-weight: 800;
    letter-spacing: 1px;
}

QPushButton#primaryBtn:hover, QPushButton.primaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00E1F2, stop:1 #70FAFF);
    color: #070B12;
}

QPushButton#protocolButton {
    background-color: rgba(0, 240, 255, 0.08);
    color: #00F0FF;
    border: 1px solid rgba(0, 240, 255, 0.4);
    border-radius: 20px;
    padding: 8px 24px;
    font-size: 9.5pt;
    font-weight: 800;
    letter-spacing: 2px;
}

QPushButton#protocolButton:hover {
    background-color: rgba(0, 240, 255, 0.2);
    border: 1px solid #00F0FF;
}

QPushButton#roundButton {
    background-color: #121A2B;
    border: 1px solid #223252;
    border-radius: 22px;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    font-size: 14pt;
    color: #94A3B8;
}

QPushButton#roundButton:hover {
    border: 1px solid #00F0FF;
    color: #00F0FF;
    background-color: #18233A;
}

QPushButton#primaryRoundButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00F0FF, stop:1 #7000FF);
    border: none;
    border-radius: 28px;
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    font-size: 18pt;
    color: #070B12;
    font-weight: bold;
}

QPushButton#primaryRoundButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #70FAFF, stop:1 #A355FF);
}

QPushButton#dangerBtn {
    background-color: rgba(255, 0, 85, 0.15);
    border: 1px solid rgba(255, 0, 85, 0.4);
    color: #FF0055;
    font-weight: bold;
}

QPushButton#dangerBtn:hover {
    background-color: rgba(255, 0, 85, 0.3);
    border: 1px solid #FF0055;
}

/* Inputs & Textboxes */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #0D131F;
    border: 1px solid #1E2C48;
    border-radius: 8px;
    padding: 10px;
    color: #F1F5F9;
    font-size: 10.5pt;
    selection-background-color: #00F0FF;
    selection-color: #070B12;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #00F0FF;
    background-color: #121A2B;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #070B12;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #1E2C48;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00F0FF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Voice Overlay */
QFrame#voiceOverlay {
    background-color: rgba(13, 19, 31, 0.95);
    border: 1px solid #00F0FF;
    border-radius: 14px;
}

QLabel#voiceState {
    color: #00F0FF;
    font-size: 10pt;
    font-weight: 800;
    letter-spacing: 1.5px;
}

QFrame#voiceBar {
    background-color: #00F0FF;
    border-radius: 2px;
}

/* Status Bar */
QStatusBar {
    background-color: #070B12;
    border-top: 1px solid #162238;
    color: #64748B;
    font-size: 9pt;
}
