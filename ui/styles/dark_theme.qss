/* ==========================================================
   OMEN — Desktop Personal AI Assistant Theme
   Linear / Raycast / Arc inspired dark minimalist aesthetic.
   Deep dark backgrounds, subtle electric cyan accents, translucent glass.
   ========================================================== */

* {
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    outline: none;
}

QMainWindow, QWidget#centralWidget {
    background-color: #09090C;
    color: #F4F4F6;
}

/* Glass Panels and Cards */
QFrame.glassCard {
    background-color: rgba(21, 21, 28, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
}

QFrame.glassCard:hover {
    border: 1px solid rgba(0, 210, 238, 0.22);
    background-color: rgba(25, 25, 34, 0.80);
}

/* Minimal Scrollbars */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 4px 0 4px 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(0, 210, 238, 0.4);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0 4px 0 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.12);
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(0, 210, 238, 0.4);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

/* Text Inputs */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #121218;
    color: #F4F4F6;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 12px;
    selection-background-color: rgba(0, 210, 238, 0.3);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #00D2EE;
    background-color: #15151E;
}

/* Buttons */
QPushButton {
    background-color: rgba(255, 255, 255, 0.05);
    color: #F4F4F6;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.14);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

QPushButton:disabled {
    color: #52525B;
    background-color: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.04);
}

QPushButton#primaryBtn {
    background-color: #00D2EE;
    color: #09090C;
    border: none;
    font-weight: 600;
}

QPushButton#primaryBtn:hover {
    background-color: #38E1F8;
}

QPushButton#primaryBtn:pressed {
    background-color: #0891B2;
}

/* Combo boxes */
QComboBox {
    background-color: #121218;
    color: #F4F4F6;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 12px;
}

QComboBox:hover {
    border-color: rgba(0, 210, 238, 0.3);
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #15151D;
    color: #F4F4F6;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    selection-background-color: rgba(0, 210, 238, 0.15);
    selection-color: #00D2EE;
}

/* Checkboxes */
QCheckBox {
    color: #E4E4E7;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background-color: #121218;
}

QCheckBox::indicator:hover {
    border-color: #00D2EE;
}

QCheckBox::indicator:checked {
    background-color: #00D2EE;
    border-color: #00D2EE;
}

/* Tooltips */
QToolTip {
    background-color: #181820;
    color: #F4F4F6;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 11px;
}
